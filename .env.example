# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

# --- Database (Prisma + PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local Postgres example:
#   postgresql://postgres:postgres@localhost:5432/nexform?schema=public
# Hosted providers (Neon, Supabase, RDS, ...) generally also need sslmode=require:
#   postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/nexform?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email (Phase 2 — wire a real driver in src/services/email.service.ts) ---
EMAIL_FROM="hello@nexform.com"
# EMAIL_API_KEY=""

# --- Storage (Phase 2 — wire a real driver in src/services/storage.service.ts) ---
STORAGE_DRIVER="local"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- First Super Admin bootstrap (scripts/create-super-admin.ts) ---
# Only needed once, as a one-off inline env var when you run the script — do not
# leave a real password sitting in .env long-term. Example:
#   SUPER_ADMIN_EMAIL="you@nexform.com" SUPER_ADMIN_PASSWORD="a-strong-password" npm run create-super-admin
# SUPER_ADMIN_EMAIL=""
# SUPER_ADMIN_PASSWORD=""
