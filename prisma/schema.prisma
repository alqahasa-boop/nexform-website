/// Key/value + JSON store. `isSecret` is a defense-in-depth flag the admin UI
/// uses to refuse rendering/exporting a value in plaintext — actual secrets
/// (API keys, SMTP credentials) belong in environment variables, never here.
model Setting {
  id       String  @id @default(uuid())
  key      String  @unique
