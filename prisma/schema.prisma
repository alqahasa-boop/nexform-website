  name       String
  nativeName String
  direction  String  @default("ltr")
  isDefault  Boolean @default(false)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())

  @@map("languages")
}

/// Polymorphic translation store for entities that don't warrant a full
/// row-per-locale (Company, FaqItem, SeoMeta, ...). See schema-level note.
model Translation {
  id         String @id @default(uuid())
  entityType String
  entityId   String
