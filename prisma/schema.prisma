// NEXFORM — Phase 2 Production Schema
//
// Read this before extending the schema further — it documents deliberate
// trade-offs the audit surfaced, so nobody "fixes" them back into a worse state.
//
// IDENTIFIERS
//   All primary keys use `String @default(uuid())` — genuine UUID v4 *values*,
//   generated by Prisma client, stored in a plain text/varchar column (not a
//   native Postgres `uuid` column via `@db.Uuid`). Native uuid columns would
//   require annotating every one of the ~90 foreign-key scalar fields in this
//   schema to match, for a storage/index benefit that doesn't matter at this
//   scale. This is a common, defensible production pattern — flagged here so
//   it's a documented decision, not an oversight.
//
// TRANSLATIONS
//   Two patterns coexist on purpose:
//   1. Row-per-locale for whole editorial pieces (Content, Project, DesignIdea,
//      Service) — each language is a full row (same as Phase 1), now linked via
//      `translationGroupId` so the EN/AR versions of "the same story" are
//      explicitly associated (Phase 1 had no such link — this was a real gap).
//      This matches how WordPress+WPML/Polylang, Contentful, and Sanity model
//      multi-language editorial content — duplicating the row keeps title/body
//      indexed, queryable, and simple, instead of splitting a single article's
//      text across many key-value rows.
//   2. The generic polymorphic `Translation` table (Phase 1, kept) for entities
//      with a handful of short fields where a full row-per-locale would be
//      overkill (Company.description, FaqItem, SeoMeta, etc).
//   Neither pattern stores fixed `titleAr`/`titleEn` columns, per the brief.
//
// MEDIA RELATIONSHIPS
//   Every *primary* media relationship (covers, galleries, logos, creatives,
//   stage attachments) is a proper typed foreign key or join table — never a
//   bare (entityType, entityId) string pair. `MediaUsage` is the one
//   deliberate exception: it's an informational "where else might this asset
//   be referenced" surfacing tool for the delete-confirmation UI, not a
//   constraint anything depends on for integrity.
//
// TAGGING
//   `Tag` + `TaggedItem` is a single polymorphic (entityType, entityId) join
//   used by Content/Project/DesignIdea/Service/ConstructionLibraryItem. Unlike
//   media, an unenforced tag link is low-stakes (worst case: a stale tag
//   pointing at a deleted row, cleaned up on delete) — one shared table beats
//   five nearly-identical `XxxTag` join tables.
//
// COUNTERS
//   view/save/share/click counters use Prisma's atomic `{ increment: 1 }`,
//   which Postgres executes as a single `UPDATE ... SET x = x + 1` — safe
//   under concurrency, no read-modify-write race. They are a fast-read cache;
//   `AnalyticsEvent` is the source of truth behind them and can rebuild them.
//
// ANALYTICS
//   One flexible `AnalyticsEvent` table, not a dedicated table per metric —
//   see the Phase 2 report for what's stored here vs. delegated to an
//   external analytics provider, and retention guidance.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum SystemRoleKey {
  GUEST
  CUSTOMER
  EDITOR
  DESIGN_MANAGER
  ADVERTISING_MANAGER
  ANALYST
  ADMIN
  SUPER_ADMIN
}

enum ContentType {
  ARTICLE
  PAGE
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum CategoryType {
  ARTICLE
  PROJECT
  DESIGN_IDEA
  SERVICE
  COMPANY
}

enum MediaKind {
  IMAGE
  PDF
  DOCUMENT
  VIDEO
}

enum DesignCategory {
  GENERAL
  FACADE
  INTERIOR
  COMMERCIAL_BOOTH
}

enum MessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum NotificationType {
  SYSTEM
  DESIGN_REQUEST
  CONTACT_MESSAGE
  CONTENT
  SECURITY
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum AnalyticsEventType {
  PAGE_VIEW
  SESSION_START
  CONTENT_VIEW
  DOWNLOAD
  SEARCH_QUERY
  COMPANY_PROFILE_VIEW
  AD_IMPRESSION
  AD_CLICK
  WHATSAPP_CLICK
  CONTACT_CLICK
  DESIGN_SAVE
  DESIGN_SHARE
  DESIGN_REQUEST_CONVERSION
  CONTACT_SUBMIT
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PUBLISH
  ARCHIVE
  UPLOAD
  DOWNLOAD
  APPROVE
  REJECT
  ASSIGN
  PERMISSION_CHANGE
  SETTINGS_CHANGE
}

enum DesignRequestStatus {
  NEW
  UNDER_REVIEW
  WAITING_FOR_CUSTOMER_INFO
  ACCEPTED
  IN_PROGRESS
  DRAFT_READY
  REVISION_REQUESTED
  FINAL_READY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DesignRequestImageRole {
  ROOM_PHOTO
  REFERENCE
  FINAL_DESIGN
  FINAL_FILE
}

enum DocumentType {
  GOVERNMENT
  BANK_FINANCE
  PDF_GUIDE
  ENGINEERING_MANUAL
  CHECKLIST
  FORM
  REGULATION
  OTHER
}

enum PricingDisplay {
  HIDDEN
  FIXED
  STARTING_AT
  CONTACT_FOR_QUOTE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  PAUSED
  EXPIRED
  REJECTED
  CANCELLED
}

// ============================================================================
// AUTH — Auth.js (NextAuth v5) compatible models + password/reset extensions
// ============================================================================

model User {
  id                  String    @id @default(uuid())
  name                String?
  email               String    @unique
  emailVerified       DateTime?
  phone               String?
  image               String?
  passwordHash        String?
  preferredLanguage   String    @default("en")
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  deletedAt           DateTime?

  /// 2FA-ready architecture: TOTP (RFC 6238) secret + hashed one-time backup codes.
  /// `twoFactorSecret` is not yet encrypted at rest — this project has no KMS/encryption-key
  /// infrastructure configured; documented here as a known follow-up, not an oversight.
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[] @default([])

  roles UserRole[]

  accounts Account[]
  sessions Session[]

  customerProfile CustomerProfile?

  contentAuthored      Content[]                    @relation("ContentAuthor")
  contentReviewed      Content[]                    @relation("ContentReviewer")
  contentUpdated       Content[]                    @relation("ContentUpdatedBy")
  projectsCreated      Project[]                    @relation("ProjectCreatedBy")
  projectTeamMemberOf  ProjectTeamMember[]
  designIdeasCreated   DesignIdea[]                 @relation("DesignIdeaCreatedBy")
  designIdeaSaves      DesignIdeaSave[]
  servicesCreated      Service[]                    @relation("ServiceCreatedBy")
  companiesCreated     Company[]                    @relation("CompanyCreatedBy")
  companyRecommended   CompanyRecommendation[]
  uploadedMedia        MediaAsset[]                 @relation("MediaUploader")
  assignedRequests     DesignRequest[]              @relation("DesignRequestAssignee")
  submittedRequests    DesignRequest[]              @relation("DesignRequestCustomer")
  requestMessages      DesignRequestMessage[]
  requestStatusChanges DesignRequestStatusHistory[]
  assignedMessages     ContactMessage[]             @relation("ContactMessageAssignee")
  contactReplies       ContactMessageReply[]
  internalNotes        InternalNote[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  activityLogs         ActivityLog[]
  passwordResetTokens  PasswordResetToken[]
  approvedCampaigns    AdvertisementCampaign[]      @relation("CampaignApprovedBy")
  contentRevisions     ContentRevision[]

  aiConversations     AiConversation[]
  aiUploadedFiles     AiUploadedFile[]
  aiWorkspace         AiUserWorkspace?
  aiPromptLogs        AiPromptLog[]
  aiGeneratedConcepts AiGeneratedConcept[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("users")
}

/// Extra fields only relevant for customer-facing accounts (role = CUSTOMER).
/// Kept separate from `User` so staff accounts don't carry unused columns.
model CustomerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String?
  address     String?
  city        String?
  country     String?
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_profiles")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Doubles as the "Email Verification Token" model — this is the exact table
/// the Auth.js Prisma adapter expects for email/magic-link flows, so a
/// separate `EmailVerificationToken` table would just be a duplicate.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Stores a SHA-256 hash of the reset token, never the raw value — even a
/// full database dump can't be replayed into a working reset link.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================================
// ROLES & PERMISSIONS
// ============================================================================

model Role {
  id          String        @id @default(uuid())
  key         SystemRoleKey @unique
  name        String
  description String?
  isSystem    Boolean       @default(true)

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

/// Many-to-many User↔Role (a user can hold more than one role, e.g. Editor +
/// Advertising Manager) — Phase 1 had a single `roleId` column on `User`,
/// which the brief's explicit "User Role" model calls out as too rigid.
model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique // e.g. "articles:publish"
  module      String // e.g. "content", "media", "advertisements"
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================================
// TAXONOMY & TAGGING
// ============================================================================

model Category {
  id       String       @id @default(uuid())
  type     CategoryType
  name     String
  slug     String
  order    Int          @default(0)
  parentId String?

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")

  content     Content[]
  projects    Project[]
  designIdeas DesignIdea[]
  services    Service[]
  companies   CompanyCategory[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([type, slug])
  @@index([parentId])
  @@index([type, deletedAt])
  @@map("categories")
}

model Tag {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  items TaggedItem[]

  createdAt DateTime @default(now())

  @@map("tags")
}

/// Single shared polymorphic join for tagging Content/Project/DesignIdea/
/// Service/ConstructionLibraryItem — see schema-level note on why tags (unlike
/// media) are an acceptable use of (entityType, entityId).
model TaggedItem {
  id         String @id @default(uuid())
  tagId      String
  entityType String
  entityId   String

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tagId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("tagged_items")
}

/// Reusable design/architectural styles (e.g. "Modern", "Neo Classic") — used
/// by DesignIdea and as a customer preference on DesignRequest.
model Style {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  designIdeas         DesignIdeaStyle[]
  preferredByRequests DesignRequestStyle[]
  projects            Project[]

  createdAt DateTime @default(now())

  @@map("styles")
}

// ============================================================================
// CONTENT MANAGEMENT — unified Article + Page
// ============================================================================

/// Articles and Pages share an identical shape (title, slug, rich body,
/// publishing workflow) — one table discriminated by `contentType`, instead
/// of two near-duplicate tables. Project/DesignIdea/Service stay separate
/// models because they carry genuinely different structured fields (area,
/// budget, pricing, ...), not just a different label.
model Content {
  id                 String        @id @default(uuid())
  contentType        ContentType
  slug               String
  title              String
  excerpt            String?
  body               String        @db.Text
  status             ContentStatus @default(DRAFT)
  visibility         Visibility    @default(PUBLIC)
  language           String        @default("en")
  translationGroupId String        @default(uuid())

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  coverImageId String?
  coverImage   MediaAsset? @relation("ContentCover", fields: [coverImageId], references: [id])

  authorId String
  author   User   @relation("ContentAuthor", fields: [authorId], references: [id])

  reviewerId String?
  reviewer   User?   @relation("ContentReviewer", fields: [reviewerId], references: [id])

  updatedById String?
  updatedBy   User?   @relation("ContentUpdatedBy", fields: [updatedById], references: [id])

  // Tags are queried via TaggedItem(entityType="Content", entityId=this.id) — polymorphic, not a typed relation.
  relatedFrom ContentRelation[] @relation("ContentRelationSource")
  relatedTo   ContentRelation[] @relation("ContentRelationTarget")

  scheduledAt DateTime?
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([contentType, language, slug])
  @@index([categoryId])
  @@index([authorId])
  @@index([status, language])
  @@index([translationGroupId])
  @@index([contentType, status, visibility])
  @@map("content")
}

/// Explicit "related content" links (e.g. "Related Articles" widget) instead
/// of an implicit/derived relation.
model ContentRelation {
  id               String @id @default(uuid())
  contentId        String
  relatedContentId String

  content        Content @relation("ContentRelationSource", fields: [contentId], references: [id], onDelete: Cascade)
  relatedContent Content @relation("ContentRelationTarget", fields: [relatedContentId], references: [id], onDelete: Cascade)

  order Int @default(0)

  @@unique([contentId, relatedContentId])
  @@map("content_relations")
}

/// Generic polymorphic revision snapshot — reused for Content, Project,
/// DesignIdea, and Service instead of a dedicated "XxxRevision" table each.
model ContentRevision {
  id         String  @id @default(uuid())
  entityType String // "Content" | "Project" | "DesignIdea" | "Service"
  entityId   String
  version    Int
  snapshot   Json
  editedById String?

  editedBy User? @relation(fields: [editedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId])
  @@map("content_revisions")
}

// ============================================================================
// CONSTRUCTION JOURNEY — ordered, nestable stages with rich attachments
// ============================================================================

model ConstructionJourneyStage {
  id                 String        @id @default(uuid())
  order              Int
  title              String
  richContent        String?       @db.Text
  status             ContentStatus @default(DRAFT)
  visibility         Visibility    @default(PUBLIC)
  language           String        @default("en")
  translationGroupId String        @default(uuid())
  parentId           String?

  parent   ConstructionJourneyStage?  @relation("StageParent", fields: [parentId], references: [id])
  children ConstructionJourneyStage[] @relation("StageParent")

  files          ConstructionJourneyStageFile[]
  companies      ConstructionJourneyStageCompany[]
  advertisements ConstructionJourneyStageAdvertisement[]
  faqs           ConstructionJourneyStageFaq[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([order])
  @@index([language])
  @@index([parentId])
  @@index([translationGroupId])
  @@map("construction_journey_stages")
}

model ConstructionJourneyStageFile {
  id           String  @id @default(uuid())
  stageId      String
  mediaAssetId String
  label        String?
  order        Int     @default(0)

  stage      ConstructionJourneyStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset               @relation("StageAttachment", fields: [mediaAssetId], references: [id])

  @@unique([stageId, mediaAssetId])
  @@index([stageId])
  @@map("construction_journey_stage_files")
}

model ConstructionJourneyStageCompany {
  stageId   String
  companyId String

  stage   ConstructionJourneyStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  company Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([stageId, companyId])
  @@map("construction_journey_stage_companies")
}

model ConstructionJourneyStageAdvertisement {
  stageId    String
  creativeId String

  stage    ConstructionJourneyStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  creative AdvertisementCreative    @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@id([stageId, creativeId])
  @@map("construction_journey_stage_ads")
}

model ConstructionJourneyStageFaq {
  stageId   String
  faqItemId String

  stage   ConstructionJourneyStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  faqItem FaqItem                  @relation(fields: [faqItemId], references: [id], onDelete: Cascade)

  @@id([stageId, faqItemId])
  @@map("construction_journey_stage_faqs")
}

// ============================================================================
// CONSTRUCTION LIBRARY — verifiable documents & downloadable resources
// ============================================================================

model ConstructionLibraryCategory {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String?
  order       Int     @default(0)
  language    String  @default("en")

  items ConstructionLibraryItem[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("construction_library_categories")
}

model ConstructionLibraryItem {
  id                 String        @id @default(uuid())
  title              String
  description        String?
  documentType       DocumentType  @default(OTHER)
  language           String        @default("en")
  translationGroupId String        @default(uuid())
  status             ContentStatus @default(DRAFT)
  visibility         Visibility    @default(PUBLIC)

  // Verification metadata — never mark a document official without a source.
  version            String?
  issueDate          DateTime?
  expiryDate         DateTime?
  sourceOrganization String?
  sourceUrl          String?
  isVerified         Boolean   @default(false)
  verifiedAt         DateTime?

  downloadCount Int @default(0)

  categoryId String
  category   ConstructionLibraryCategory @relation(fields: [categoryId], references: [id])

  fileId String?
  file   MediaAsset? @relation("LibraryItemFile", fields: [fileId], references: [id])

  // Tags are queried via TaggedItem(entityType="ConstructionLibraryItem", entityId=this.id).
  relatedFrom ConstructionLibraryRelation[] @relation("LibraryRelationSource")
  relatedTo   ConstructionLibraryRelation[] @relation("LibraryRelationTarget")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([categoryId])
  @@index([documentType])
  @@index([translationGroupId])
  @@map("construction_library_items")
}

model ConstructionLibraryRelation {
  id            String @id @default(uuid())
  itemId        String
  relatedItemId String

  item        ConstructionLibraryItem @relation("LibraryRelationSource", fields: [itemId], references: [id], onDelete: Cascade)
  relatedItem ConstructionLibraryItem @relation("LibraryRelationTarget", fields: [relatedItemId], references: [id], onDelete: Cascade)

  @@unique([itemId, relatedItemId])
  @@map("construction_library_relations")
}

model FaqItem {
  id          String  @id @default(uuid())
  question    String
  answer      String  @db.Text
  category    String?
  order       Int     @default(0)
  language    String  @default("en")
  isPublished Boolean @default(false)

  journeyStages ConstructionJourneyStageFaq[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([category])
  @@index([language])
  @@map("faq_items")
}

// ============================================================================
// DESIGN INSPIRATION
// ============================================================================

model DesignIdea {
  id                 String         @id @default(uuid())
  slug               String
  title              String
  description        String?        @db.Text
  designCategory     DesignCategory @default(GENERAL)
  status             ContentStatus  @default(DRAFT)
  visibility         Visibility     @default(PUBLIC)
  language           String         @default("en")
  translationGroupId String         @default(uuid())

  roomType   String?
  areaSqm    Decimal? @db.Decimal(10, 2)
  dimensions Json?
  floorCount Int?
  budgetMin  Decimal? @db.Decimal(12, 2)
  budgetMax  Decimal? @db.Decimal(12, 2)

  designerId   String?
  designer     User?   @relation("DesignIdeaCreatedBy", fields: [designerId], references: [id])
  designerName String? // free-text attribution for external/guest designers

  featured Boolean @default(false)

  viewCount  Int @default(0)
  saveCount  Int @default(0)
  shareCount Int @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  coverImageId String?
  coverImage   MediaAsset? @relation("DesignIdeaCover", fields: [coverImageId], references: [id])

  galleryItems DesignIdeaGalleryItem[]
  styles       DesignIdeaStyle[]
  // Tags are queried via TaggedItem(entityType="DesignIdea", entityId=this.id).
  saves        DesignIdeaSave[]

  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([language, slug])
  @@index([designCategory])
  @@index([categoryId])
  @@index([status, language, visibility])
  @@index([translationGroupId])
  @@index([featured])
  @@map("design_ideas")
}

model DesignIdeaGalleryItem {
  id           String @id @default(uuid())
  designIdeaId String
  mediaAssetId String
  order        Int    @default(0)

  designIdea DesignIdea @relation(fields: [designIdeaId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation("DesignIdeaGalleryAsset", fields: [mediaAssetId], references: [id])

  @@unique([designIdeaId, mediaAssetId])
  @@index([designIdeaId])
  @@map("design_idea_gallery_items")
}

model DesignIdeaStyle {
  designIdeaId String
  styleId      String

  designIdea DesignIdea @relation(fields: [designIdeaId], references: [id], onDelete: Cascade)
  style      Style      @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([designIdeaId, styleId])
  @@map("design_idea_styles")
}

/// Per-user save/favorite records — a raw counter can't tell you *who* saved
/// something or support un-saving; this is the source of truth, `saveCount`
/// on `DesignIdea` is the fast-read cache kept in sync via atomic increments.
model DesignIdeaSave {
  id           String @id @default(uuid())
  designIdeaId String
  userId       String

  designIdea DesignIdea @relation(fields: [designIdeaId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([designIdeaId, userId])
  @@index([userId])
  @@map("design_idea_saves")
}

// ============================================================================
// PROJECTS
// ============================================================================

model Project {
  id                 String        @id @default(uuid())
  slug               String
  title              String
  summary            String?
  description        String?       @db.Text
  status             ContentStatus @default(DRAFT)
  visibility         Visibility    @default(PUBLIC)
  language           String        @default("en")
  translationGroupId String        @default(uuid())

  projectType    String?
  location       String?
  areaSqm        Decimal?  @db.Decimal(10, 2)
  completionDate DateTime?
  clientName     String?
  videoUrl       String?
  featured       Boolean   @default(false)

  styleId String?
  style   Style?  @relation(fields: [styleId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  coverImageId String?
  coverImage   MediaAsset? @relation("ProjectCover", fields: [coverImageId], references: [id])

  galleryItems ProjectGalleryItem[]
  team         ProjectTeamMember[]
  // Tags are queried via TaggedItem(entityType="Project", entityId=this.id).

  createdById String
  createdBy   User   @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([language, slug])
  @@index([categoryId])
  @@index([createdById])
  @@index([status, language, visibility])
  @@index([translationGroupId])
  @@index([featured])
  @@map("projects")
}

model ProjectGalleryItem {
  id           String @id @default(uuid())
  projectId    String
  mediaAssetId String
  order        Int    @default(0)

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation("ProjectGalleryAsset", fields: [mediaAssetId], references: [id])

  @@unique([projectId, mediaAssetId])
  @@index([projectId])
  @@map("project_gallery_items")
}

model ProjectTeamMember {
  projectId String
  userId    String
  roleLabel String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_team_members")
}

// ============================================================================
// SERVICES
// ============================================================================

model Service {
  id                 String        @id @default(uuid())
  slug               String
  title              String
  description        String?       @db.Text
  status             ContentStatus @default(DRAFT)
  visibility         Visibility    @default(PUBLIC)
  language           String        @default("en")
  translationGroupId String        @default(uuid())

  pricingDisplay PricingDisplay @default(CONTACT_FOR_QUOTE)
  price          Decimal?       @db.Decimal(12, 2)
  isRequestable  Boolean        @default(true)
  order          Int            @default(0)

  icon     String? // lucide-react icon name, e.g. "Compass" — rendered on the public services grid
  features String[] @default([])
  ctaLabel String?
  ctaUrl   String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  coverImageId String?
  coverImage   MediaAsset? @relation("ServiceCover", fields: [coverImageId], references: [id])

  // Tags are queried via TaggedItem(entityType="Service", entityId=this.id).

  createdById String
  createdBy   User   @relation("ServiceCreatedBy", fields: [createdById], references: [id])

  designRequests DesignRequest[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([language, slug])
  @@index([categoryId])
  @@index([status, language, visibility])
  @@index([translationGroupId])
  @@map("services")
}

// ============================================================================
// MEDIA LIBRARY
// ============================================================================

model MediaFolder {
  id       String  @id @default(uuid())
  name     String
  parentId String?

  parent   MediaFolder?  @relation("FolderParent", fields: [parentId], references: [id])
  children MediaFolder[] @relation("FolderParent")
  assets   MediaAsset[]

  createdAt DateTime @default(now())

  @@index([parentId])
  @@map("media_folders")
}

model MediaTag {
  id     String          @id @default(uuid())
  name   String          @unique
  assets MediaAssetTag[]

  @@map("media_tags")
}

model MediaAssetTag {
  mediaAssetId String
  tagId        String

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  tag        MediaTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaAssetId, tagId])
  @@map("media_asset_tags")
}

model MediaAsset {
  id        String    @id @default(uuid())
  kind      MediaKind
  fileName  String
  url       String
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?
  alt       String?
  caption   String?

  storageProvider String  @default("local") // "local" | "s3" | "supabase" | ...
  storageKey      String?
  isPublic        Boolean @default(true)

  downloadCount Int @default(0)

  /// Points at the row that replaced this one — lets old references keep
  /// working while surfacing that a newer version exists ("file replacement").
  replacedById    String?     @unique
  replacedBy      MediaAsset? @relation("MediaReplacement", fields: [replacedById], references: [id])
  previousVersion MediaAsset? @relation("MediaReplacement")

  folderId String?
  folder   MediaFolder? @relation(fields: [folderId], references: [id])

  tags   MediaAssetTag[]
  usages MediaUsage[]

  uploadedById String
  uploadedBy   User   @relation("MediaUploader", fields: [uploadedById], references: [id])

  // Typed reverse relations — every *primary* media usage is a real FK, not a loose string pair.
  contentCovers          Content[]                      @relation("ContentCover")
  projectCovers          Project[]                      @relation("ProjectCover")
  projectGalleryItems    ProjectGalleryItem[]           @relation("ProjectGalleryAsset")
  serviceCovers          Service[]                      @relation("ServiceCover")
  designIdeaCovers       DesignIdea[]                   @relation("DesignIdeaCover")
  designIdeaGalleries    DesignIdeaGalleryItem[]        @relation("DesignIdeaGalleryAsset")
  libraryItemFiles       ConstructionLibraryItem[]      @relation("LibraryItemFile")
  stageAttachments       ConstructionJourneyStageFile[] @relation("StageAttachment")
  companyLogos           Company[]                      @relation("CompanyLogo")
  companyGalleryItems    CompanyGalleryItem[]           @relation("CompanyGalleryAsset")
  advertisementCreatives AdvertisementCreative[]        @relation("CreativeImage")
  designRequestImages    DesignRequestImage[]           @relation("DesignRequestAsset")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([kind])
  @@index([folderId])
  @@index([deletedAt])
  @@map("media_assets")
}

/// Generic "where is this asset used" tracker for the delete-confirmation UI —
/// intentionally the one place a loose (entityType, entityId) pair is used;
/// see schema-level note.
model MediaUsage {
  id           String @id @default(uuid())
  mediaAssetId String
  entityType   String
  entityId     String

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([mediaAssetId])
  @@index([entityType, entityId])
  @@map("media_usages")
}

// ============================================================================
// COMPANIES DIRECTORY
// ============================================================================

/// Sellable listing tiers for the Companies Directory (e.g. "Basic", "Featured",
/// "Premium") — mirrors the AdvertisementPackage pattern already used for ad
/// campaigns, applied here to directory listing depth/duration instead.
model CompanyListingPackage {
  id               String   @id @default(uuid())
  name             String
  description      String?
  durationDays     Int?
  price            Decimal? @db.Decimal(12, 2)
  maxFeaturedSlots Int?
  isActive         Boolean  @default(true)

  companies Company[]

  createdAt DateTime @default(now())

  @@map("company_listing_packages")
}

model Company {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  description  String? @db.Text
  website      String?
  whatsapp     String?
  phone        String?
  email        String?
  address      String?
  latitude     Float?
  longitude    Float?
  workingHours Json?
  socialLinks  Json?

  verificationStatus VerificationStatus @default(UNVERIFIED)
  approvalStatus     ApprovalStatus     @default(PENDING)
  featured           Boolean            @default(false)
  isActive           Boolean            @default(true)

  listingPackageId String?
  listingPackage   CompanyListingPackage? @relation(fields: [listingPackageId], references: [id])
  packageExpiresAt DateTime?

  profileViews   Int @default(0)
  contactClicks  Int @default(0)
  whatsappClicks Int @default(0)

  logoId String?
  logo   MediaAsset? @relation("CompanyLogo", fields: [logoId], references: [id])

  categories      CompanyCategory[]
  gallery         CompanyGalleryItem[]
  recommendations CompanyRecommendation[]

  journeyStages ConstructionJourneyStageCompany[]
  campaigns     AdvertisementCampaign[]

  createdById String
  createdBy   User   @relation("CompanyCreatedBy", fields: [createdById], references: [id])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([approvalStatus])
  @@index([verificationStatus])
  @@index([featured])
  @@map("companies")
}

model CompanyCategory {
  companyId  String
  categoryId String

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([companyId, categoryId])
  @@map("company_categories")
}

model CompanyGalleryItem {
  id           String @id @default(uuid())
  companyId    String
  mediaAssetId String
  order        Int    @default(0)

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation("CompanyGalleryAsset", fields: [mediaAssetId], references: [id])

  @@unique([companyId, mediaAssetId])
  @@map("company_gallery_items")
}

/// Independent editorial "we recommend this company" — always separate from
/// any paid `AdvertisementCampaign`, so a rendered page can label paid vs.
/// organic placements truthfully.
model CompanyRecommendation {
  id              String  @id @default(uuid())
  companyId       String
  reason          String? @db.Text
  isActive        Boolean @default(true)
  recommendedById String

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recommendedBy User    @relation(fields: [recommendedById], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("company_recommendations")
}

// ============================================================================
// ADVERTISING SYSTEM
// ============================================================================

model AdvertisementPackage {
  id            String   @id @default(uuid())
  name          String
  description   String?
  durationDays  Int?
  price         Decimal? @db.Decimal(12, 2)
  maxPlacements Int?
  isActive      Boolean  @default(true)

  campaigns AdvertisementCampaign[]

  createdAt DateTime @default(now())

  @@map("advertisement_packages")
}

model AdvertisementPlacement {
  id                String  @id @default(uuid())
  key               String  @unique // e.g. "homepage-hero-banner"
  name              String
  description       String?
  pageContext       String? // e.g. "homepage" | "construction-journey" | "design-inspiration"
  recommendedWidth  Int?
  recommendedHeight Int?

  campaignPlacements AdvertisementCampaignPlacement[]

  createdAt DateTime @default(now())

  @@map("advertisement_placements")
}

/// The sellable unit — a company's ad booking. Replaces Phase 1's flat
/// `Advertisement` model, which conflated "campaign" and "creative" into one
/// row and couldn't represent one campaign running different creatives
/// across multiple placements, an approval workflow, or a package/billing
/// reference. This is a correction, not an addition — Phase 1's `Advertisement`
/// model is retired in favor of Campaign + Creative + CampaignPlacement.
model AdvertisementCampaign {
  id        String         @id @default(uuid())
  name      String
  companyId String
  packageId String?
  status    CampaignStatus @default(DRAFT)
  priority  Int            @default(0)

  startDate DateTime?
  endDate   DateTime?

  billingReferenceId String? // opaque reference for a future payment/billing integration

  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?

  company    Company               @relation(fields: [companyId], references: [id])
  package    AdvertisementPackage? @relation(fields: [packageId], references: [id])
  approvedBy User?                 @relation("CampaignApprovedBy", fields: [approvedById], references: [id])

  creatives  AdvertisementCreative[]
  placements AdvertisementCampaignPlacement[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("advertisement_campaigns")
}

model AdvertisementCreative {
  id             String  @id @default(uuid())
  campaignId     String
  title          String
  imageId        String?
  targetUrl      String?
  whatsappNumber String?
  callToAction   String?

  campaign AdvertisementCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  image    MediaAsset?           @relation("CreativeImage", fields: [imageId], references: [id])

  placements    AdvertisementCampaignPlacement[]
  journeyStages ConstructionJourneyStageAdvertisement[]

  clickCount      Int @default(0)
  impressionCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@map("advertisement_creatives")
}

model AdvertisementCampaignPlacement {
  id          String @id @default(uuid())
  campaignId  String
  placementId String
  creativeId  String

  /// Which device classes this booking should render on — empty array means "all devices".
  deviceTargeting String[] @default([])

  campaign  AdvertisementCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placement AdvertisementPlacement @relation(fields: [placementId], references: [id])
  creative  AdvertisementCreative  @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@unique([campaignId, placementId, creativeId])
  @@index([placementId])
  @@map("advertisement_campaign_placements")
}

// ============================================================================
// DESIGN REQUESTS — full workflow
// ============================================================================

model DesignRequest {
  id            String              @id @default(uuid())
  requestNumber String              @unique
  status        DesignRequestStatus @default(NEW)
  priority      RequestPriority     @default(NORMAL)

  // Guest contact fallback — a request can exist without a registered account.
  fullName String
  email    String
  phone    String?

  customerId String?
  customer   User?   @relation("DesignRequestCustomer", fields: [customerId], references: [id])

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  propertyType String?
  roomType     String?
  measurements Json?
  budgetMin    Decimal? @db.Decimal(12, 2)
  budgetMax    Decimal? @db.Decimal(12, 2)
  notes        String?  @db.Text

  assignedToId String?
  assignedTo   User?   @relation("DesignRequestAssignee", fields: [assignedToId], references: [id])

  preferredStyles DesignRequestStyle[]
  images          DesignRequestImage[]
  messages        DesignRequestMessage[]
  statusHistory   DesignRequestStatusHistory[]

  deliveredAt DateTime?
  completedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([assignedToId])
  @@index([customerId])
  @@map("design_requests")
}

model DesignRequestStyle {
  designRequestId String
  styleId         String

  designRequest DesignRequest @relation(fields: [designRequestId], references: [id], onDelete: Cascade)
  style         Style         @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([designRequestId, styleId])
  @@map("design_request_styles")
}

/// Room photos, references, final designs, and final files were four
/// near-identical "attach a file to this request" cases — one typed join
/// discriminated by `role` instead of four tables.
model DesignRequestImage {
  id              String                 @id @default(uuid())
  designRequestId String
  mediaAssetId    String
  role            DesignRequestImageRole
  order           Int                    @default(0)

  designRequest DesignRequest @relation(fields: [designRequestId], references: [id], onDelete: Cascade)
  mediaAsset    MediaAsset    @relation("DesignRequestAsset", fields: [mediaAssetId], references: [id])

  createdAt DateTime @default(now())

  @@index([designRequestId, role])
  @@map("design_request_images")
}

/// Append-only — a status change never overwrites history, it adds a row.
model DesignRequestStatusHistory {
  id              String               @id @default(uuid())
  designRequestId String
  fromStatus      DesignRequestStatus?
  toStatus        DesignRequestStatus
  note            String?
  changedById     String?

  designRequest DesignRequest @relation(fields: [designRequestId], references: [id], onDelete: Cascade)
  changedBy     User?         @relation(fields: [changedById], references: [id])

  createdAt DateTime @default(now())

  @@index([designRequestId])
  @@map("design_request_status_history")
}

/// Customer-visible conversation *and* internal admin discussion on the same
/// request, disambiguated by `isInternal` rather than two parallel tables.
model DesignRequestMessage {
  id              String  @id @default(uuid())
  designRequestId String
  authorId        String?
  authorName      String? // fallback for guest customers without a User row
  body            String  @db.Text
  isInternal      Boolean @default(false)

  designRequest DesignRequest @relation(fields: [designRequestId], references: [id], onDelete: Cascade)
  author        User?         @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([designRequestId])
  @@map("design_request_messages")
}

